{
  "name": "qa-practice",
  "version": "1.0.0",
  "description": "Web, desktop (Electron) and mobile (Android) test automation practice",
  "scripts": {
    "test": "echo 'use test:web, test:desktop or test:mobile' && exit 1",
    "test:web": "playwright test --project=reference --project=with-bugs",
    "test:desktop": "playwright test --project=electron",
    "test:mobile": "wdio run mobile/wdio.conf.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@wdio/appium-service": "10.2.0",
    "@wdio/cli": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "appium": "3.9.0",
    "appium-uiautomator2-driver": "8.7.3",
    "electron": "45.2.3",
    "typescript": "5.9.3"
  }
}
